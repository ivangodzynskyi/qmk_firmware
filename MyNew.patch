-    return state;
+        }
+
+        // Clear the X and Y values of the mouse report
+        mouse_report.x = 0;
+        mouse_report.y = 0;
+    }
+    if (get_mods() & MOD_MASK_SHIFT) {
+        mouse_report.x *= 3;
+        mouse_report.y *= 3;
+    }
+    return mouse_report;
 }
 
