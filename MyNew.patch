++      }
++      return false;
++    // combined tab and layer 2 key
++    case BW_TAB_L2:
++      if (record->event.pressed) {
++        tab_l2_timer = timer_read();
++        layer_on(2); 
++      } else {
++        layer_off(2);
++        if (timer_elapsed(tab_l2_timer) < BW_TAP_TIME)
++          tap_code(KC_TAB);
++      }
++      return false;
++      // combined backspace and layer 3 key
++    case BW_BSPC_L3:
++      if (record->event.pressed) {
++        bspc_l3_timer = timer_read();
++        layer_on(3); 
++      } else {
++        layer_off(3); 
